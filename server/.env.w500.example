# Set these in the myWindowsHosting Node.js App environment settings.
# Never commit real credentials or secrets.
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME
JWT_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS
BOOTSTRAP_TOKEN=REPLACE_WITH_A_ONE_TIME_RANDOM_TOKEN
CORS_ORIGIN=https://YOUR-FRONTEND-DOMAIN
DB_SSL=false
# PORT is assigned by the hosting platform; do not set a fixed port.
